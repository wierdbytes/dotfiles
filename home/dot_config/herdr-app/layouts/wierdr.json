{
  "id": "root",
  "preview": "layouts/wierdr.svg",
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 268
      },
      "min": 220,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "sidebar-top",
          "type": "block",
          "content": {
            "mod": "wierdr-sidebar",
            "props": {
              "top": true
            }
          },
          "size": {
            "px": 42
          },
          "window_drag": true
        },
        {
          "id": "spaces",
          "type": "block",
          "content": {
            "mod": "wierdr-sidebar"
          },
          "size": {
            "weight": 1
          },
          "min": 90
        },
        {
          "id": "sidebar-header",
          "type": "row",
          "size": {
            "px": 45
          },
          "resizable": false,
          "children": [
            {
              "id": "limit-rings",
              "type": "block",
              "content": {
                "mod": "limits",
                "props": {
                  "rings": true
                }
              },
              "size": {
                "weight": 1
              }
            },
            {
              "id": "status-ring",
              "type": "block",
              "content": {
                "mod": "wierdr-sidebar",
                "props": {
                  "ring": true
                }
              },
              "size": {
                "px": 40
              }
            },
            {
              "id": "sidebar-plus",
              "type": "block",
              "content": {
                "mod": "wierdr-sidebar",
                "props": {
                  "plus": true
                }
              },
              "size": {
                "weight": 1
              }
            }
          ]
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "wierd-tabs"
          },
          "size": {
            "px": 42
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "wierd-pane"
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "radius": 10,
                  "gap": 8,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    },
                    {
                      "id": "memory",
                      "type": "block",
                      "content": {
                        "mod": "wierd-memory"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true
            }
          ],
          "padding": 8,
          "gap": 8
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ]
}
